AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional. Set for local MinIO: http://127.0.0.1:9000
S3_ENDPOINT=
CLOUDFRONT_URL=https://your-distribution.cloudfront.net

# Postgres (docker compose up postgres). Host 5434 avoids clashes with other local DBs.
DATABASE_URL=postgresql://gsplat:gsplat@localhost:5434/gsplat

# Host draft reconstructor polls with this secret. Next.js only orchestrates jobs.
# Generate a long random value. Never ship the default.
WORKER_SECRET=
# Optional push notify (reconstructor primarily polls claim). Leave empty for poll-only.
WORKER_URL=
APP_URL=http://localhost:3000
