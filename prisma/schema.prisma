generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReconstructionStatus {
  UPLOADING
  QUEUED
  EXTRACTING_FRAMES
  RUNNING_COLMAP
  TRAINING_SPLAT
  CONVERTING_SOG
  UPLOADING_RESULT
  COMPLETED
  FAILED
}

model ReconstructionJob {
  id                String               @id @default(uuid())
  name              String
  status            ReconstructionStatus @default(UPLOADING)
  progress          Int                  @default(0)
  originalVideoKey  String?
  originalVideoUrl  String?
  originalVideoName String?
  outputSplatKey    String?
  outputSplatUrl    String?
  outputSogKey      String?
  outputSogUrl      String?
  thumbnailKey      String?
  thumbnailUrl      String?
  error             String?
  durationSeconds   Float?
  frameCount        Int?
  processingMs      Int?
  gpuType           String?
  outputSizeBytes   BigInt?
  sourceSizeBytes   BigInt?
  resolution        String?
  splatBackend      String               @default("external")
  claimedAt         DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([updatedAt])
}
