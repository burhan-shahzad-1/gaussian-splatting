# GPU worker — Next.js never loads this file.
#
# docker compose --profile gpu up --build worker
# python process.py serve --port 8080
# python process.py poll
# python process.py job --job-id <id> --original-video-key captures/<id>/walkthrough.mp4

APP_URL=http://localhost:3000
WORKER_SECRET=
KEEP_SCRATCH=false
WORKER_POLL=true

# Object storage (IAM role on the GPU host is enough; keys optional)
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CLOUDFRONT_URL=
OUTPUT_PREFIX=reconstructions

# Scratch + GPU
WORK_DIR=/work
GPU_DEVICE=0
GPU_TYPE=

# Frames
FRAME_FPS=2
FRAME_MAX_WIDTH=1600
MIN_VIDEO_SECONDS=2
MIN_FRAMES=8

# COLMAP (apt package is usually CPU-only; set 1 if your binary is CUDA-built)
COLMAP_USE_GPU=0
COLMAP_CAMERA_MODEL=SIMPLE_PINHOLE
MIN_REGISTERED_CAMERAS=8

# Existing 3DGS trainer (gsplat | 3dgs | external)
SPLAT_BACKEND=gsplat
SPLAT_TRAIN_CMD=
GSPLAT_EXAMPLES_DIR=/opt/gsplat/examples
GAUSSIAN_SPLATTING_DIR=/opt/gaussian-splatting
TRAIN_ITERATIONS=30000
TRAIN_DATA_FACTOR=1

# PlayCanvas SplatTransform (installed as splat-transform in the image)
SOG_CONVERT_CMD=
VALIDATE_SOG_ROUNDTRIP=true
