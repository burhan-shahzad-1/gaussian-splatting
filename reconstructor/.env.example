# Host draft reconstructor — not loaded by Next.js.
# Same WORKER_SECRET as the Next.js app (.env.local).

APP_URL=http://localhost:3000
WORKER_SECRET=

# Object storage (match Next.js / MinIO)
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=gsplat
AWS_SECRET_ACCESS_KEY=gsplatgsplat
S3_BUCKET=gsplat
S3_ENDPOINT=http://127.0.0.1:9000
CLOUDFRONT_URL=http://127.0.0.1:9000/gsplat
OUTPUT_PREFIX=reconstructions

# Scratch on this machine
# WORK_DIR defaults to %TEMP%\gsplat-work on Windows
KEEP_SCRATCH=false
GPU_DEVICE=0
POLL_SECONDS=8

# 8 GB laptop draft caps (target: a couple of minutes per upload)
FRAME_FPS=2
FRAME_MAX_WIDTH=640
FRAME_MAX_COUNT=8
TRAIN_ITERATIONS=800
TRAIN_DATA_FACTOR=4
CAMERA_BACKEND=fast_vggt
MIN_FRAMES=4
MIN_REGISTERED_CAMERAS=4

# Clone these once, then point here:
#   git clone https://github.com/facebookresearch/vggt.git
#   git clone https://github.com/nerfstudio-project/gsplat.git
VGGT_DIR=
GSPLAT_EXAMPLES_DIR=
